# Rootless Quadlet unit for the perfume dashboard.
#
#   cp perfume-dashboard.container perfume-data.volume ~/.config/containers/systemd/
#   systemctl --user daemon-reload
#   systemctl --user start perfume-dashboard
#
# Needs Podman 4.5 or newer.

[Unit]
Description=Perfume dashboard
Wants=network-online.target
After=network-online.target

[Container]
ContainerName=perfume-dashboard
Image=localhost/perfume-dashboard:latest
# Publishing the image to a registry? Point Image= at it and uncomment, then
# enable podman-auto-update.timer to pick up new versions automatically:
# AutoUpdate=registry
# (AutoUpdate=local does the same for a locally rebuilt localhost/ image.)

PublishPort=8080:8080
Volume=perfume-data.volume:/data:Z

Environment=LATITUDE=52.3676
Environment=LONGITUDE=4.9041
Environment=LOCATION_NAME=Amsterdam
Environment=TIMEZONE=Europe/Amsterdam
Environment=UNITS=metric
# Or keep the settings in a file (same KEY=value lines) and drop the lines above:
# EnvironmentFile=%h/.config/perfume-dashboard.env

# Duplicates the image's HEALTHCHECK so it also works for images built in OCI format.
HealthCmd=node -e "fetch('http://127.0.0.1:8080/healthz').then(r=>process.exit(r.ok?0:1),()=>process.exit(1))"
HealthInterval=30s
HealthTimeout=5s
HealthStartPeriod=10s
HealthRetries=3
# Podman 4.6+: kill an unhealthy container so systemd restarts it.
# HealthOnFailure=kill

# The app only ever writes to /data.
ReadOnly=true
NoNewPrivileges=true
DropCapability=ALL

[Service]
Restart=always
# Leave room for a first-time image pull.
TimeoutStartSec=300

[Install]
WantedBy=default.target
